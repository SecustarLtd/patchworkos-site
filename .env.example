NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./patchwork.db
BACKUPS_DIR=./backups

# Start with Paystack test keys. Never expose the secret in browser code.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_GROWTH_PLAN_CODE=PLN_replace_me # Growth: KES 500/month
PAYSTACK_ENTERPRISE_PLAN_CODE=PLN_replace_me # Enterprise: KES 1,000/month
PAYSTACK_SUBACCOUNT_CODE=ACCT_c0ajy946qg0z5w1 # Secustar Limited USD (NCBA Bank Kenya 1012524015, 100% split)
PAYSTACK_PROVISION_PLANS=false

# Unified Patchwork OS Runtime & Dashboard Integration
DASHBOARD_SESSION_SECRET=replace-with-same-secret-as-patchwork-os
PATCHWORK_DASHBOARD_URL=http://127.0.0.1:3200
PATCHWORK_PORTAL_URL=http://127.0.0.1:3000
PATCHWORK_POST_AUTH_REDIRECT=/plan
