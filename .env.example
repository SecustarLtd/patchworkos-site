NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000

# Start with Paystack test keys. Never expose the secret in browser code.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_GROWTH_PLAN_CODE=PLN_replace_me # Growth: KES 500/month
PAYSTACK_ENTERPRISE_PLAN_CODE=PLN_replace_me # Enterprise: KES 1,000/month
PAYSTACK_PROVISION_PLANS=false
